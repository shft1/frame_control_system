    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const code = pm.response.code;",
              "pm.test(\"status 200 or 429\", () => pm.expect([200,429]).to.include(code));",
              "const j = pm.response.json();",
              "if (code === 200) {",
              "  pm.environment.set(\"token\", j.data.token);",
              "  pm.test(\"token present\", () => pm.expect(j.data.token).to.be.a('string'));",
              "} else if (code === 429) {",
              "  pm.test(\"rate limited error\", () => pm.expect(j.error && j.error.code).to.eql('rate_limited'));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
