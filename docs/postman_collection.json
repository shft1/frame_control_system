  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test(\"success true\", () => pm.expect(j.success).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/healthz" }
    },
    {
      "name": "Dev: seed admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"status 200/201\", () => pm.expect([200,201]).to.include(pm.response.code));",
              "const j = pm.response.json();",
              "pm.environment.set(\"adminToken\", j.data.token);",
              "pm.test(\"admin token present\", () => pm.expect(j.data.token).to.be.a('string'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\",\n  \"name\": \"Admin\"\n}"
        },
        "url": "{{baseUrl}}/dev/seed-admin"
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// При повторном запуске возможен 409 — это ок",
              "pm.expect([201,409]).to.include(pm.response.code);",
              "if (pm.response.code === 201) {",
              "  const j = pm.response.json();",
              "  pm.test(\"created returns id\", () => pm.expect(j.data.id).to.be.a('string'));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"u1@example.com\",\n  \"password\": \"secret12\",\n  \"name\": \"User One\"\n}" },
        "url": "{{baseUrl}}/users/register"
      }
    },
