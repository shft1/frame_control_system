          "script": {
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.environment.set(\"token\", j.data.token);",
              "pm.test(\"token present\", () => pm.expect(j.data.token).to.be.a('string'));"
